# Docker Compose configuration (compose.yaml). Copy to .env in this folder:  cp .env.example .env
# Each app also has its own .env.example for running without Docker.
# Never commit a real .env file.

# --- Required: generate fresh random values ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# openssl rand -base64 32   (or the Python command above)
NEXTAUTH_SECRET=

# --- Optional ---
# Host ports. Change them if 3000 or 8000 are already in use.
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Set to "true" to run the frontend with sample data only.
DEMO_MODE=false
# External SR-GAN/DenseNet/LLM endpoint. While empty, analysis and chat return a clear "service unavailable" error.
INFERENCE_SERVICE_URL=
# Password for the local PostgreSQL container (not published outside the Compose network).
POSTGRES_PASSWORD=superray-local
