# SuperRay frontend configuration.
#
# Local development:  cp .env.example .env.local   (Next.js loads .env.local automatically)
# Production (Vercel): set these in Project → Settings → Environment Variables, then redeploy.
# Never commit a real .env.local file.

# --- Public: inlined into the browser bundle at build time. Never put secrets here. ---
# Demonstration mode (sample data, no backend needed) is ON unless this is exactly "false".
#   Frontend only:        leave as "true".
#   With a local backend: set to "false" and run the Django API (see ../SuperRay-Backend).
NEXT_PUBLIC_DEMO_MODE=true
# Django REST API base URL including /api/. Only used when NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000/api/

# Optional: Firebase project for the contact form (Firestore "contact" collection).
# Firebase web config is shipped to the browser by design. Restrict the API key in Google Cloud
# (HTTP referrers + Firebase APIs only) and lock down Firestore rules. The form is disabled while unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Server-only: used by NextAuth on the server, never exposed to the browser. ---
# Canonical URL of this frontend. Production example: https://superray.vercel.app
NEXTAUTH_URL=http://localhost:3000
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional. Backend URL as seen from the Next.js server when it differs from the browser's
# (e.g. http://backend:8000/api/ in Docker Compose). Defaults to NEXT_PUBLIC_BACKEND_URL.
INTERNAL_BACKEND_URL=
# Optional Google sign-in (live mode only). Must match the backend's GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
