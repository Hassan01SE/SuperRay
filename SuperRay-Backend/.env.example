# SuperRay backend configuration.
#
# Local development:  cp .env.example .env   (the values below work as-is with SQLite and local media)
# Production (Azure): set these as App Service "Application settings" instead of using a .env file.
#                     Real environment variables always take precedence over .env.
# Never commit a real .env file.

# --- Core ---
# true only for local development. Production must use false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Comma-separated host names. Production example: your-app.azurewebsites.net
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins for the Django admin over HTTPS. Production example: https://your-app.azurewebsites.net
DJANGO_CSRF_TRUSTED_ORIGINS=
# Frontend origins allowed to call the API. Production example: https://superray.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (SQLite in ./db.sqlite3 is used while POSTGRES_HOST is empty) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=superraydb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# --- Uploaded media (./media on disk is used while AZURE_ACCOUNT_NAME is empty) ---
# Production: a storage account with a PRIVATE container; images are served as short-lived signed URLs.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_MEDIA_CONTAINER=media
AZURE_URL_EXPIRATION_SECS=3600
MAX_UPLOAD_SIZE_MB=10

# --- Google sign-in (optional; must match the frontend's GOOGLE_CLIENT_ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- External inference service (SR-GAN + DenseNet + LLM) ---
# Endpoint implementing the JSON contract in README.md. While empty, analysis and chat return HTTP 503.
INFERENCE_SERVICE_URL=
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_THROTTLE_ANON=10/hour
INFERENCE_THROTTLE_USER=60/hour

# --- Optional tuning ---
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
# Production security settings (only applied when DJANGO_DEBUG=false)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO
